{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tooling/typescript/base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": [
    "packages/*/src/**/*.test.ts",
    "**/node_modules",
    "**/dist"
  ]
}
